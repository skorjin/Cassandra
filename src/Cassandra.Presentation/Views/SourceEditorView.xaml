<UserControl x:Class="Cassandra.Presentation.Views.SourceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBox x:Name="SourceBox" Style="{StaticResource FieldBox}" Height="70" AutomationProperties.Name="Оригинал"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource WarnBrush}" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
        <Button Content="Перевести" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Margin="0,6,0,0"
                Command="{Binding TranslateCommand}"/>
    </StackPanel>
</UserControl>
