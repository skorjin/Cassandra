<UserControl x:Class="Cassandra.Presentation.Views.SettingsDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Cassandra.Presentation.ViewModels">
    <!-- DataContext is the HUD view model: Settings, Models and Update are its children. -->
    <UserControl.Resources>
        <!-- round colour swatch; the selected one gets a thick white ring -->
        <ControlTemplate x:Key="ColorDot" TargetType="Button">
            <Ellipse x:Name="Dot" Fill="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                     Stroke="#55FFFFFF" StrokeThickness="1.5"/>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Dot" Property="Stroke" Value="White"/>
                    <Setter TargetName="Dot" Property="StrokeThickness" Value="2.5"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <StackPanel Margin="10,8,10,10">

        <!-- Section tabs -->
        <Border Background="#4D000000" CornerRadius="6" Padding="2" Margin="0,0,0,10">
            <UniformGrid Rows="1">
                <RadioButton GroupName="Section" Style="{StaticResource SegmentButton}" Content="Вид"
                             IsChecked="{Binding Settings.IsAppearance, Mode=OneWay}"
                             Command="{Binding Settings.ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Appearance}"/>
                <RadioButton GroupName="Section" Style="{StaticResource SegmentButton}" Content="Языки"
                             IsChecked="{Binding Settings.IsLanguages, Mode=OneWay}"
                             Command="{Binding Settings.ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Languages}"/>
                <RadioButton GroupName="Section" Style="{StaticResource SegmentButton}" Content="Модели"
                             IsChecked="{Binding Settings.IsModels, Mode=OneWay}"
                             Command="{Binding Settings.ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Models}"/>
                <RadioButton GroupName="Section" Style="{StaticResource SegmentButton}" Content="Версия"
                             IsChecked="{Binding Settings.IsApp, Mode=OneWay}"
                             Command="{Binding Settings.ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.App}"/>
            </UniformGrid>
        </Border>

        <!-- Appearance: opacity, background, font -->
        <StackPanel Visibility="{Binding Settings.IsAppearance, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Text="Прозрачность" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                <Slider Grid.Row="0" Grid.Column="1" Minimum="0.3" Maximum="1" Value="{Binding Settings.Opacity, Mode=TwoWay}"
                        SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" AutomationProperties.Name="Прозрачность"/>

                <TextBlock Grid.Row="1" Text="Цвет фона" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Settings.Tints}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding Name}"
                                    AutomationProperties.Name="{Binding Name}" Template="{StaticResource ColorDot}"
                                    Command="{Binding DataContext.Settings.SelectTintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="Размер шрифта" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right" Width="26" TextAlignment="Right" Style="{StaticResource CaptionText}"
                               Text="{Binding Settings.FontSize, StringFormat={}{0:0}}" VerticalAlignment="Center"/>
                    <Slider Minimum="10" Maximum="30" Value="{Binding Settings.FontSize, Mode=TwoWay}" IsSnapToTickEnabled="True"
                            TickFrequency="1" SmallChange="1" LargeChange="2" VerticalAlignment="Center"
                            AutomationProperties.Name="Размер шрифта"/>
                </DockPanel>

                <TextBlock Grid.Row="3" Text="Цвет текста" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Settings.TextColors}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding Name}"
                                    AutomationProperties.Name="{Binding Name}" Template="{StaticResource ColorDot}"
                                    Command="{Binding DataContext.Settings.SelectTextColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- live preview of the text style -->
            <Border Background="#33000000" CornerRadius="6" Padding="8" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="{Binding Settings.FontSize}"
                           Foreground="{Binding Settings.TextColor, Converter={StaticResource HexToBrushConverter}}">
                    <Run Text="Ник:" Foreground="{StaticResource SpeakerBrush}" FontWeight="SemiBold"/>
                    <Run Text="Пример переведённого сообщения"/>
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Languages -->
        <StackPanel Visibility="{Binding Settings.IsLanguages, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Языки чата" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
            <Border Background="#4D000000" CornerRadius="6" Padding="2">
                <UniformGrid Rows="1">
                    <RadioButton GroupName="Lang" Content="EN → RU" Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding Settings.IsEnRu, Mode=OneWay}" Command="{Binding Settings.SelectEnRuCommand}"/>
                    <RadioButton GroupName="Lang" Content="RU → EN" Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding Settings.IsRuEn, Mode=OneWay}" Command="{Binding Settings.SelectRuEnCommand}"/>
                </UniformGrid>
            </Border>
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                       Text="Что читаем в чате и на что переводим. Ответ переводится в обратную сторону."/>
        </StackPanel>

        <!-- Translation models -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360" Focusable="False"
                      Visibility="{Binding Settings.IsModels, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding Models.Error}" Foreground="{StaticResource WarnBrush}" Style="{StaticResource HintText}"
                           Margin="0,0,0,6"/>

                <ItemsControl ItemsSource="{Binding Models.Options}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Background="#33000000" Padding="9" Margin="0,0,0,6" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding StateText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>

                                    <!-- download progress -->
                                    <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="6"
                                                     Foreground="{StaticResource AccentBrush}" Background="#33000000" BorderThickness="0"/>
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- network trouble, pause, failure -->
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource HintText}" Margin="0,4,0,0"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#FBBF24"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <!-- confirmation with the size warning -->
                                    <Border Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                            Background="#26FBBF24" CornerRadius="5" Padding="8" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ConfirmText}" Foreground="{StaticResource TextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                <Button Content="Отмена" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                        Command="{Binding CancelPendingCommand}"/>
                                                <Button Content="Подтвердить" Style="{StaticResource ActionButton}" Command="{Binding ConfirmCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Content="Удалить" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding RequestDeleteCommand}"/>
                                        <Button Content="Пауза" Style="{StaticResource GhostButton}"
                                                Visibility="{Binding ShowPause, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding PauseCommand}"/>
                                        <Button Content="{Binding DownloadLabel}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                                Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding RequestDownloadCommand}"/>
                                        <Button Content="Использовать" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                                Visibility="{Binding ShowActivate, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding ActivateCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Application version and updates -->
        <StackPanel Visibility="{Binding Settings.IsApp, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Update.VersionText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                <TextBlock Text="Приложение" Style="{StaticResource CaptionText}"/>
            </DockPanel>
            <TextBlock Text="{Binding Update.Status}" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Update.ProgressPercent, Mode=OneWay}" Height="6" Margin="0,6,0,0"
                         Foreground="{StaticResource AccentBrush}" Background="#33000000" BorderThickness="0"
                         Visibility="{Binding Update.ShowProgress, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Проверить обновления" Style="{StaticResource GhostButton}"
                        Visibility="{Binding Update.CanCheck, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding Update.CheckCommand}"/>
                <Button Content="{Binding Update.InstallLabel}" Style="{StaticResource ActionButton}"
                        Visibility="{Binding Update.HasUpdate, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding Update.InstallCommand}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
