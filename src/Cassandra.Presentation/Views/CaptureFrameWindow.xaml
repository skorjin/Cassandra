<Window x:Class="Cassandra.Presentation.Views.CaptureFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Cassandra.Presentation.Converters"
        Title="Cassandra capture frame"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        MinWidth="120" MinHeight="40" Width="380" Height="120" Cursor="SizeAll">
    <Grid>
        <Rectangle Stroke="#7FD1FF" StrokeThickness="1.5" StrokeDashArray="4 3" Margin="1" RadiusX="3" RadiusY="3"/>

        <!-- Corner grips -->
        <Thumb x:Name="TopLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
        <Thumb x:Name="TopRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
        <Thumb x:Name="BottomLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
        <Thumb x:Name="BottomRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
    <Window.Resources>
        <Style TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="#7FD1FF" Width="8" Height="8" RadiusX="2" RadiusY="2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
