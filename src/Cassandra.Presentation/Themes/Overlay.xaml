<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Cassandra.Presentation.Converters">

    <!-- Colors -->
    <SolidColorBrush x:Key="TextBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#99EEF1F6"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#66EEF1F6"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7FD1FF"/>
    <SolidColorBrush x:Key="SpeakerBrush" Color="#FFCB6B"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#59000000"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="GoBrush" Color="#2F6DF6"/>
    <SolidColorBrush x:Key="GoHoverBrush" Color="#4A82FF"/>
    <SolidColorBrush x:Key="OkBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="RunBrush" Color="#4ADE80"/>

    <conv:HudBackgroundConverter x:Key="HudBackgroundConverter"/>
    <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
    <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Icons (16x16 grid) -->
    <Geometry x:Key="IconPause">M5,3 L5,13 M11,3 L11,13</Geometry>
    <Geometry x:Key="IconPlay">M5,3 L13,8 L5,13 Z</Geometry>
    <Geometry x:Key="IconGear">M8,5.8 A2.2,2.2 0 1 1 7.99,5.8 Z M8,1.5 L8,3.1 M8,12.9 L8,14.5 M1.5,8 L3.1,8 M12.9,8 L14.5,8 M3.4,3.4 L4.5,4.5 M11.5,11.5 L12.6,12.6 M3.4,12.6 L4.5,11.5 M11.5,4.5 L12.6,3.4</Geometry>
    <Geometry x:Key="IconPencil">M3,13 L4,9.8 L11.2,2.6 L13.4,4.8 L6.2,12 Z</Geometry>
    <Geometry x:Key="IconFrame">M2,6 L2,2 L6,2 M10,2 L14,2 L14,6 M14,10 L14,14 L10,14 M6,14 L2,14 L2,10</Geometry>
    <Geometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</Geometry>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="1,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Opacity="0.78">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource GoBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="#24FFFFFF"/>
    </Style>

    <!-- Segmented tab / language switch -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="6,5" Opacity="0.65">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#29FFFFFF"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FieldBorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="6,5">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
