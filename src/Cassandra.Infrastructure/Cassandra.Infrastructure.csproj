<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cassandra.Domain\Cassandra.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cassandra.Infrastructure.Tests" />
  </ItemGroup>

  <!-- The catalog works offline: a copy is always shipped inside the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\models.json" LogicalName="catalog.models.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
