<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cassandra</AssemblyName>
    <RootNamespace>Cassandra.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\cassandra.ico</ApplicationIcon>
    <StartupObject>Cassandra.App.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
    <Product>Cassandra</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cassandra.Presentation\Cassandra.Presentation.csproj" />
    <ProjectReference Include="..\Cassandra.Infrastructure\Cassandra.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <!-- Own entry point (Program.cs) so that Velopack can run before WPF starts. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <!-- OCR language data (about 8 MB) ships with the app. Translation models are downloaded by the user. -->
  <ItemGroup>
    <None Include="..\..\tessdata\**\*" Link="tessdata\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
